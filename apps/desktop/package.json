{
  "name": "@tongpin/desktop",
  "version": "0.0.0",
  "productName": "同频会议",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && vue-tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "pack": "pnpm build && electron-builder --dir",
    "dist": "pnpm build && electron-builder",
    "dist:mac": "pnpm build && electron-builder --mac",
    "dist:win": "pnpm build && electron-builder --win",
    "dist:linux": "pnpm build && electron-builder --linux"
  },
  "devDependencies": {
    "@tongpin/config": "workspace:*",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "electron": "catalog:",
    "electron-builder": "catalog:",
    "electron-vite": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  },
  "dependencies": {
    "@tongpin/app-core": "workspace:*",
    "@tongpin/platform": "workspace:*",
    "@tongpin/tokens": "workspace:*",
    "electron-updater": "^6.0.0",
    "vue": "catalog:",
    "vue-router": "catalog:"
  },
  "description": "同频会议桌面客户端",
  "author": "同频会议"
}

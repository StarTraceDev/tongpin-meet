{
  "name": "tongpin-meet",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "dev:web": "pnpm --filter @tongpin/web dev",
    "dev:admin": "pnpm --filter @tongpin/admin dev",
    "dev:desktop": "pnpm --filter @tongpin/desktop dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "prepare": "husky",
    "db:generate": "pnpm --filter @tongpin/server db:generate",
    "db:migrate": "pnpm --filter @tongpin/server db:migrate",
    "db:deploy": "pnpm --filter @tongpin/server db:deploy",
    "db:studio": "pnpm --filter @tongpin/server db:studio",
    "db:seed": "pnpm --filter @tongpin/server db:seed",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test -c playwright.ui.config.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@tongpin/config": "workspace:*",
    "eslint": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "@playwright/test": "catalog:"
  }
}

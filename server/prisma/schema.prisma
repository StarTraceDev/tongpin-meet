// 03 §5：Prisma 7，provider = "prisma-client"，输出到 libs/infra/src/generated/prisma。
// 全量 29 张表：组织 5 + 会议 3 + 互动 8 + 内容 4 + 反馈 1 + 平台 5 + 03 §5.7 新增 3。

generator client {
  provider     = "prisma-client"
  output       = "../libs/infra/src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// 组织域：User / Dept / Role / UserRole / DeviceSession
// ============================================================================

model User {
  id           String     @id @default(cuid()) // 主键（cuid，禁止数字自增）
  legacyId     Int?       @unique // 存量系统数字 ID（迁移对照用）
  phone        String     @unique // 手机号：唯一登录凭据
  passwordHash String? // argon2 哈希；null = 未设密码
  name         String // 昵称
  avatarUrl    String? // 头像地址
  email        String? // 邮箱
  deptId       String? // 主部门 ID（超管可为空）
  tokenVersion Int        @default(0) // +1 即让所有已签发 access 失效
  status       UserStatus @default(ACTIVE) // 账号状态
  lastLoginAt  DateTime? // 最近登录时间
  createdAt    DateTime   @default(now()) // 创建时间
  updatedAt    DateTime   @updatedAt // 更新时间
  deletedAt    DateTime? // 软删标记

  dept           Dept?                @relation(fields: [deptId], references: [id])
  roles          UserRole[]
  sessions       DeviceSession[]
  participations MeetingParticipant[]
  hostedMeetings Meeting[]            @relation("MeetingHost")

  @@index([deptId])
  @@map("users")
  qrSessions       QrSession[] // 该用户确认过的设备码会话
}

model Dept {
  id        String    @id @default(cuid()) // 主键
  legacyId  Int?      @unique // 存量系统数字 ID
  name      String // 部门名称
  parentId  String? // 上级部门 ID（树形，顶级为空）
  sort      Int       @default(0) // 排序值（小在前）
  createdAt DateTime  @default(now()) // 创建时间
  updatedAt DateTime  @updatedAt // 更新时间
  deletedAt DateTime? // 软删标记

  parent   Dept?  @relation("DeptTree", fields: [parentId], references: [id])
  children Dept[] @relation("DeptTree")
  users    User[]

  @@index([parentId])
  @@map("depts")
}

model Role {
  id          String    @id @default(cuid()) // 主键
  code        String    @unique // 角色编码（SUPER_ADMIN / ADMIN / MEMBER ...）
  name        String // 角色名称
  permissions Json      @default("[]") // 权限点数组
  builtin     Boolean   @default(false) // 内置角色不可删
  createdAt   DateTime  @default(now()) // 创建时间
  updatedAt   DateTime  @updatedAt // 更新时间
  deletedAt   DateTime? // 软删标记

  users UserRole[]

  @@map("roles")
}

model UserRole {
  id        String   @id @default(cuid()) // 主键
  userId    String // 用户 ID
  roleId    String // 角色 ID
  grantedAt DateTime @default(now()) // 授予时间

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model DeviceSession {
  id              String    @id // jti，由签发方生成
  userId          String // 所属用户
  deviceId        String // 客户端设备标识
  refreshHash     String // refresh token 哈希（只存哈希）
  prevRefreshHash String? // 上一次 refresh 哈希：检测 token 复用
  ua              String? // User-Agent
  ip              String? // 登录 IP
  expiresAt       DateTime // refresh 过期时间
  revokedAt       DateTime? // 吊销时间
  createdAt       DateTime  @default(now()) // 登录时间

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("device_sessions")
}

// ============================================================================
// 会议域：Meeting / MeetingParticipant / MeetingEvent
// ============================================================================

model Meeting {
  id            String        @id @default(cuid()) // 主键
  meetingNo     String        @unique // 9 位随机数字，对外可见
  title         String // 会议主题
  hostId        String // 主持人用户 ID（可转移）
  roomName      String        @unique // RTC 房间名（服务端生成 lk_{id}_{rand}）
  status        MeetingStatus @default(SCHEDULED) // 会议状态
  startAt       DateTime // 计划开始时间
  endAt         DateTime // 计划结束时间
  timezone      String        @default("Asia/Shanghai") // 时区（IANA）
  passwordHash  String? // 会议密码哈希（永不明文返回）
  settings      Json // 会议设置（muteOnJoin / watermark / allowGuest / autoRecord）
  actualStartAt DateTime? // 实际开始时间
  actualEndAt   DateTime? // 实际结束时间
  seriesId      String? // 周期会议实例共享的系列 ID
  recurrenceRule String? // RFC 5545 RRULE，仅系列首条有值
  hostKey       String? // 6 位主持人密钥（哈希存）
  lockedAt      DateTime? // 锁定时间，非空即锁定
  allowWaitingRoom Boolean @default(false) // 是否开等候室（与 settings 二选一，定死读这里）
  createdAt     DateTime      @default(now()) // 创建时间
  updatedAt     DateTime      @updatedAt // 更新时间
  deletedAt     DateTime? // 软删标记

  host          User                 @relation("MeetingHost", fields: [hostId], references: [id])
  participants  MeetingParticipant[]
  events        MeetingEvent[]
  checkins      Checkin[]
  votes         Vote[]
  breaks        Break[]
  files         MeetingFile[]
  minutes       MeetingMinutes?
  recordings    Recording[]
  operations    Operation[]
  waitingEntries WaitingRoomEntry[]

  @@index([hostId, startAt])
  @@index([status, startAt])
  @@index([seriesId])
  @@map("meetings")
}

enum MeetingStatus {
  SCHEDULED // 已预定（未开始）
  ONGOING // 进行中
  ENDED // 已结束
  CANCELLED // 已取消
  EXPIRED // 超时未开始而失效
}

model MeetingParticipant {
  id          String          @id @default(cuid()) // 主键
  legacyId    Int?            @unique // 存量系统数字 ID
  meetingId   String // 会议 ID
  userId      String? // 成员用户 ID（游客为空）
  guestName   String? // 游客昵称（用户为空时必填）
  role        ParticipantRole @default(ATTENDEE) // 会中角色
  joinedAt    DateTime? // 实际入会时间
  leftAt      DateTime? // 离会时间
  mediaState  Json // { audioOn, videoOn, screenSharing }
  createdAt   DateTime        @default(now()) // 加入名单时间

  meeting Meeting @relation(fields: [meetingId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])

  @@unique([meetingId, userId])
  @@index([userId])
  @@map("meeting_participants")
}

enum ParticipantRole {
  HOST // 主持人
  COHOST // 联席主持人
  ATTENDEE // 普通参会人
  GUEST // 游客
}

/// C1 权威事件落库，供重连 lastSeq 增量回放
model MeetingEvent {
  id        String   @id @default(cuid()) // 主键
  meetingId String // 会议 ID
  seq       Int // 会议内自增序号（服务端生成）
  type      String // 事件类型（meeting.member.joined ...）
  fromUid   String? // 触发者用户 ID
  data      Json // 事件负载（业务字段一律放 data）
  ts        DateTime @default(now()) // 服务端时间戳

  meeting Meeting @relation(fields: [meetingId], references: [id])

  @@unique([meetingId, seq])
  @@map("meeting_events")
}

enum UserStatus {
  ACTIVE // 正常
  DISABLED // 已禁用
}

// ============================================================================
// 会中互动：Checkin / Vote / Break（03 §5.4 状态机，共享 INTERACTION_STATUS）
// ============================================================================

model Checkin {
  id          String            @id @default(cuid()) // 主键
  meetingId   String // 会议 ID
  title       String // 签到主题
  status      InteractionStatus @default(ONGOING) // 进行中 / 已关闭（单向）
  anonymous   Boolean           @default(false) // 是否匿名（结果不展示实名）
  createdById String // 发起人用户 ID
  createdAt   DateTime          @default(now()) // 发起时间
  closedAt    DateTime? // 关闭时间

  meeting Meeting         @relation(fields: [meetingId], references: [id])
  records CheckinRecord[]

  @@index([meetingId])
  @@map("checkins")
}

enum InteractionStatus {
  ONGOING // 进行中
  CLOSED // 已关闭（终态，不可重开）
}

model CheckinRecord {
  id          String   @id @default(cuid()) // 主键
  checkinId   String // 签到 ID
  userId      String // 签到人用户 ID
  respondedAt DateTime @default(now()) // 签到时间

  checkin Checkin @relation(fields: [checkinId], references: [id])

  @@unique([checkinId, userId])
  @@map("checkin_records")
}

model Vote {
  id          String     @id @default(cuid()) // 主键
  meetingId   String // 会议 ID
  title       String // 投票标题
  status      VoteStatus @default(DRAFT) // 草稿→进行中→已关闭→已公布
  anonymous   Boolean    @default(false) // 是否匿名投票
  createdById String // 发起人用户 ID
  createdAt   DateTime   @default(now()) // 创建时间
  startedAt   DateTime? // 开始时间（:start）
  closedAt    DateTime? // 截止时间（:close）
  publishedAt DateTime? // 结果公布时间（:publish）

  meeting   Meeting        @relation(fields: [meetingId], references: [id])
  questions VoteQuestion[]
  records   VoteRecord[]

  @@index([meetingId])
  @@map("votes")
}

enum VoteStatus {
  DRAFT // 草稿（可编辑）
  ONGOING // 进行中（可提交）
  CLOSED // 已截止（不可提交，结果未公布）
  PUBLISHED // 已公布（终态）
}

model VoteQuestion {
  id      String           @id @default(cuid()) // 主键
  voteId  String // 投票 ID
  index   Int // 题序（从 1 开始）
  content String // 题干
  type    VoteQuestionType @default(SINGLE) // 题型

  vote    Vote         @relation(fields: [voteId], references: [id])
  options VoteOption[]

  @@unique([voteId, index])
  @@map("vote_questions")
}

enum VoteQuestionType {
  SINGLE // 单选
  MULTI // 多选
  RATING // 评分
}

model VoteOption {
  id         String @id @default(cuid()) // 主键
  questionId String // 题目 ID
  index      Int // 选项序号
  content    String // 选项内容

  question VoteQuestion @relation(fields: [questionId], references: [id])

  @@unique([questionId, index])
  @@map("vote_options")
}

model VoteRecord {
  id          String   @id @default(cuid()) // 主键
  voteId      String // 投票 ID
  userId      String // 投票人用户 ID
  answers     Json // 作答内容（题目 ID → 选项 ID 数组）
  submittedAt DateTime @default(now()) // 提交时间

  vote Vote @relation(fields: [voteId], references: [id])

  @@unique([voteId, userId])
  @@map("vote_records")
}

model Break {
  id          String            @id @default(cuid()) // 主键
  meetingId   String // 会议 ID
  title       String? // 休息说明（如「茶歇 10 分钟」）
  status      InteractionStatus @default(ONGOING) // 休息中 / 已结束（单向）
  plannedSec  Int? // 计划时长（秒，仅展示倒计时）
  createdById String // 发起人用户 ID
  startedAt   DateTime          @default(now()) // 开始时间
  endedAt     DateTime? // 结束时间（:close）

  meeting Meeting       @relation(fields: [meetingId], references: [id])
  records BreakRecord[]

  @@index([meetingId])
  @@map("breaks")
}

model BreakRecord {
  id        String   @id @default(cuid()) // 主键
  breakId   String // 休息 ID
  userId    String // 成员用户 ID
  resting   Boolean  @default(true) // true 去休息 / false 回来
  changedAt DateTime @default(now()) // 状态变更时间

  break_ Break @relation(fields: [breakId], references: [id])

  @@unique([breakId, userId])
  @@map("break_records")
}

// ============================================================================
// 内容域：MeetingFile / MeetingMinutes / Recording / RecordingSegment
// ============================================================================

model MeetingFile {
  id         String     @id @default(cuid()) // 主键
  meetingId  String // 所属会议 ID
  uploaderId String // 上传人用户 ID
  name       String // 文件名（展示用）
  mime       String? // MIME 类型
  sizeBytes  Int        @default(0) // 文件大小（字节）
  storageKey String // 存储键（内部路径，不对外暴露）
  status     FileStatus @default(UPLOADING) // 上传状态
  createdAt  DateTime   @default(now()) // 创建时间
  deletedAt  DateTime? // 软删标记（DELETE /files/{id}）

  meeting Meeting @relation(fields: [meetingId], references: [id])

  @@index([meetingId])
  @@map("meeting_files")
}

enum FileStatus {
  UPLOADING // 上传中（已创建上传凭证）
  READY // 可下载
}

/// 会议纪要：每会一份（GET/PATCH /meetings/{id}/minutes）
model MeetingMinutes {
  id          String        @id @default(cuid()) // 主键
  meetingId   String        @unique // 会议 ID（一个会议一份纪要）
  content     String        @default("") // 纪要内容（Markdown）
  transcript  Json? // 语音转写原文（AI 纪要的输入）
  status      MinutesStatus @default(PENDING) // 纪要状态
  version     Int           @default(0) // 内容版本号（ETag 依据）
  updatedById String? // 最后编辑人用户 ID
  createdAt   DateTime      @default(now()) // 创建时间
  updatedAt   DateTime      @updatedAt // 更新时间

  meeting Meeting @relation(fields: [meetingId], references: [id])

  @@map("meeting_minutes")
}

enum MinutesStatus {
  PENDING // 未生成
  GENERATING // 生成中
  READY // 已就绪
}

model Recording {
  id          String          @id @default(cuid()) // 主键
  legacyId    Int?            @unique // 存量系统录制 ID
  meetingId   String // 会议 ID
  startedById String // 发起录制人用户 ID
  status      RecordingStatus @default(REQUESTED) // 录制状态（任一步可 FAILED）
  durationSec Int? // 总时长（秒）
  sizeBytes   Int? // 总大小（字节）
  startedAt   DateTime        @default(now()) // 开始时间
  stoppedAt   DateTime? // 停止时间（:stop）

  meeting  Meeting            @relation(fields: [meetingId], references: [id])
  segments RecordingSegment[]

  @@index([meetingId])
  @@map("recordings")
}

enum RecordingStatus {
  REQUESTED // 已请求
  RECORDING // 录制中
  PROCESSING // 转码/切片处理中
  READY // 可下载
  FAILED // 处理失败
}

model RecordingSegment {
  id          String   @id @default(cuid()) // 主键
  recordingId String // 录制 ID
  index       Int // 分片序号（从 1 开始）
  storageKey  String // 存储键（内部路径）
  sizeBytes   Int? // 分片大小（字节）
  startSec    Int? // 分片起点（相对录制开始，秒）
  endSec      Int? // 分片终点（秒）
  createdAt   DateTime @default(now()) // 创建时间

  recording Recording @relation(fields: [recordingId], references: [id])

  @@unique([recordingId, index])
  @@map("recording_segments")
}

// ============================================================================
// 反馈域：Feedback（2026-11-03 新增，docs/03 §4 / §5 反馈段）
// ============================================================================

/// 投诉反馈：管理台代录 + 处理闭环（GET/POST /admin/feedbacks、PATCH 处理）
model Feedback {
  id         String           @id @default(cuid()) // 主键
  category   FeedbackCategory @default(OTHER) // 建议 / 投诉 / 故障 / 其他
  content    String // 反馈正文
  contact    String? // 联系方式（可空）
  status     FeedbackStatus   @default(PENDING) // 状态机见 §5.4
  source     FeedbackSource   @default(ADMIN) // 管理台代录 / 用户自助
  reporterId String? // 自助提交人 userId（代录为空）
  handledBy  String? // 处理人 userId
  reply      String? // 处理回复
  handledAt  DateTime? // 处理完成时间
  createdAt  DateTime         @default(now()) // 创建时间
  updatedAt  DateTime         @updatedAt // 更新时间

  @@index([status])
  @@index([createdAt])
  @@map("feedbacks")
}

enum FeedbackStatus {
  PENDING
  PROCESSING
  RESOLVED
  REJECTED
}

enum FeedbackCategory {
  SUGGESTION
  COMPLAINT
  ISSUE
  OTHER
}

enum FeedbackSource {
  ADMIN
  USER
}

// ============================================================================
// 平台域：Operation / AuditLog / LoginLog / SysConfig / FeatureFlag
// ============================================================================

/// 异步操作：导出/生成类任务统一返回 202 + 本表 ID
model Operation {
  id            String          @id @default(cuid()) // 主键
  kind          String // 操作类型（checkin-records-export / participants-export ...）
  status        OperationStatus @default(PENDING) // 处理状态
  meetingId     String? // 关联会议（可空）
  requestedById String // 发起人用户 ID
  progress      Int             @default(0) // 进度百分比（0-100）
  result        Json? // 结果（下载地址 / 统计摘要）
  error         String? // 失败原因（内部诊断用）
  createdAt     DateTime        @default(now()) // 创建时间
  finishedAt    DateTime? // 完成时间

  meeting Meeting? @relation(fields: [meetingId], references: [id])

  @@index([requestedById])
  @@index([status])
  @@map("operations")
}

enum OperationStatus {
  PENDING // 排队中
  RUNNING // 执行中
  SUCCEEDED // 成功
  FAILED // 失败
}

/// 审计日志：管理台关键操作留痕
model AuditLog {
  id         String   @id @default(cuid()) // 主键
  actorId    String // 操作者用户 ID
  action     String // 动作（meeting.force-end / config.update ...）
  targetType String? // 目标类型（meeting / user / config）
  targetId   String? // 目标 ID
  detail     Json? // 变更详情（差异快照）
  ip         String? // 操作者 IP
  ua         String? // 操作者 User-Agent
  createdAt  DateTime @default(now()) // 发生时间

  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// 登录日志：每次登录尝试一条（成功 / 失败都记）
model LoginLog {
  id        String   @id @default(cuid()) // 主键
  userId    String? // 用户 ID（自动注册首登前可能为空）
  phone     String // 登录手机号
  channel   String // 登录方式（password / sms / qr）
  success   Boolean // 是否成功
  reason    String? // 失败原因（code_invalid / rate_limited ...）
  ip        String? // 登录 IP
  ua        String? // 登录设备 User-Agent
  createdAt DateTime @default(now()) // 发生时间

  @@index([phone])
  @@index([createdAt])
  @@map("login_logs")
}

/// 系统配置：管理台可视化配置
model SysConfig {
  id          String   @id @default(cuid()) // 主键
  key         String   @unique // 配置键
  value       Json // 配置值
  description String? // 说明
  updatedById String? // 最后修改人
  updatedAt   DateTime @updatedAt // 更新时间
  createdAt   DateTime @default(now()) // 创建时间

  @@map("sys_configs")
}

/// 功能开关：灰度/实验开关（按用户 ID 或百分比放量）
model FeatureFlag {
  id          String   @id @default(cuid()) // 主键
  key         String   @unique // 开关键
  enabled     Boolean  @default(false) // 总开关
  description String? // 说明
  rolloutPct  Int      @default(0) // 放量百分比（0-100）
  payload     Json? // 附加配置（客户端按需读取）
  updatedAt   DateTime @updatedAt // 更新时间
  createdAt   DateTime @default(now()) // 创建时间

  @@map("feature_flags")
}

// ============================================================================
// 03 §5.7 新增：Notification / Announcement / WaitingRoomEntry
// ============================================================================

model Notification {
  id        String           @id @default(cuid()) // 主键
  userId    String // 收件人
  type      NotificationType // 通知类型
  title     String // 标题
  body      String? // 正文
  link      String? // 点击跳转的路由
  readAt    DateTime? // 已读时间
  createdAt DateTime         @default(now()) // 创建时间

  @@index([userId, readAt])
  @@map("notifications")
}

enum NotificationType {
  MEETING_INVITE // 会议邀请
  MEETING_START // 会议即将开始
  SYSTEM // 系统通知
  FEEDBACK_REPLY // 反馈回复
}

model Announcement {
  id        String   @id @default(cuid()) // 主键
  title     String // 标题
  content   String // 正文（Markdown）
  pinned    Boolean  @default(false) // 是否置顶
  publishAt DateTime // 定时发布时间
  expireAt  DateTime? // 过期时间
  createdBy String // 创建人用户 ID
  createdAt DateTime @default(now()) // 创建时间

  @@map("announcements")
}

model WaitingRoomEntry {
  id        String        @id @default(cuid()) // 主键
  meetingId String // 会议 ID
  guestName String? // 游客昵称（登录用户可为空）
  userId    String? // 登录用户 ID
  status    WaitingStatus @default(PENDING) // PENDING / ADMITTED / DENIED
  createdAt DateTime      @default(now()) // 创建时间

  meeting Meeting @relation(fields: [meetingId], references: [id])

  @@index([meetingId, status])
  @@map("waiting_room_entries")
}

enum WaitingStatus {
  PENDING // 等待中
  ADMITTED // 已准入
  DENIED // 已拒绝
}

// ============================================================================
// 认证：设备码 / 扫码登录会话（04 §6.1：本期用设备码替代手机扫码）
// ============================================================================

enum QrSessionStatus {
  PENDING // 已创建，等已登录浏览器确认
  CONFIRMED // 已确认，等 PC 拉取一次 token
  CONSUMED // token 已被 PC 取走，不能再用
  REJECTED // 确认方拒绝
  EXPIRED // 超过有效期
}

model QrSession {
  id              String          @id @default(cuid())
  code            String // 6 位设备码，PENDING 期间唯一
  status          QrSessionStatus @default(PENDING)
  userId          String? // 确认者；创建时为空
  deviceSessionId String? // 取 token 时签发的会话，防止重复发
  expiresAt       DateTime // 创建后 5 分钟
  confirmedAt     DateTime?
  createdAt       DateTime        @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([code, status])
  @@index([expiresAt])
  @@map("qr_sessions")
}

/// 06 §11.8 短信服务商；secret 只写不读，库里存 AES-256-GCM 密文
model SmsProvider {
  id           String    @id @default(cuid())
  code         String    @unique // ALIYUN / TENCENT / CUSTOM
  name         String
  endpoint     String?
  accessKeyId  String
  secretCipher String // 密文 base64（iv:tag:data）
  secretLast4  String // 掩码展示用，只存后 4 位
  signName     String
  templateCode String?
  enabled      Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  templates SmsTemplate[]
  logs      SmsLog[]

  @@map("sms_providers")
}

model SmsTemplate {
  id         String    @id @default(cuid())
  code       String    @unique
  name       String
  content    String
  providerId String?
  enabled    Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  provider SmsProvider? @relation(fields: [providerId], references: [id])

  @@map("sms_templates")
}

model SmsLog {
  id         String   @id @default(cuid())
  phone      String
  template   String
  providerId String?
  status     String // SENT / FAILED
  error      String?
  createdAt  DateTime @default(now())

  provider SmsProvider? @relation(fields: [providerId], references: [id])

  @@index([createdAt])
  @@index([phone])
  @@map("sms_logs")
}

/// 06 §11.9 AI 服务商；密钥只写不读，库里存 AES-256-GCM 密文
model AiProvider {
  id          String    @id @default(cuid())
  code        String    @unique // OPENAI / DASHSCOPE / DEEPSEEK
  name        String
  baseUrl     String
  apiKeyCipher String
  apiKeyLast4 String
  model       String // 默认模型
  enabled     Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  routes AiRoute[]
  usages AiUsage[]

  @@map("ai_providers")
}

model AiRoute {
  id            String   @id @default(cuid())
  scene         String   @unique // minutes / qa / summary
  providerId    String?
  modelOverride String?
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  provider AiProvider? @relation(fields: [providerId], references: [id])

  @@map("ai_routes")
}

model AiUsage {
  id               String   @id @default(cuid())
  scene            String
  providerId       String?
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  costCents        Int      @default(0)
  createdAt        DateTime @default(now())

  provider AiProvider? @relation(fields: [providerId], references: [id])

  @@index([createdAt])
  @@index([scene])
  @@map("ai_usage")
}

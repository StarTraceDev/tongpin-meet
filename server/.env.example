# 复制成 .env 后按需改；.env 不进版本库（07 §11.2）
cp .env.example .env

# ── 必填 ────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:123456@localhost:5432/tongpin"
NODE_ENV=development
PORT=3000
GATEWAY_PORT=3001
AI_PORT=3002
PUBLIC_API_ORIGIN="http://localhost:3000"
JWT_SECRET="local-dev-secret-do-not-use-in-prod"
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET="local-dev-refresh-secret-do-not-use-in-prod"
JWT_REFRESH_TTL=30d
AUTH_AUTO_REGISTER=true

# ── 可选：*_PROVIDER 是唯一开关，不填即降级 ─────────────
# CACHE_PROVIDER=memory            # redis | memory
# REDIS_URL=redis://localhost:6379
# SMS_PROVIDER=mock                # aliyun | mock
# SMS_ACCESS_KEY_ID=
# SMS_ACCESS_KEY_SECRET=
# SMS_SIGN_NAME=
# STORAGE_PROVIDER=local           # s3 | local
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=tongpin
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# RTC_PROVIDER=mock                # livekit | mock
# LIVEKIT_URL=ws://localhost:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=devsecret
# AI_PROVIDER=mock                 # openai | mock
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=

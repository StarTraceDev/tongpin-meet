{
  "extends": "@tongpin/config/tsconfig/node.json",
  "compilerOptions": {
    "baseUrl": ".",
    "outDir": "./dist",
    "paths": {
      "@app/common": ["libs/common/src/index.ts"],
      "@app/common/*": ["libs/common/src/*"],
      "@tongpin/shared": ["../packages/shared/src/index.ts"],
      "@tongpin/shared/*": ["../packages/shared/src/*/index.ts"]
    }
  },
  "include": ["apps/**/*.ts", "libs/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
